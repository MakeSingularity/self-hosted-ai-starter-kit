# Global ffmpeg settings for stable connections
ffmpeg:
  hwaccel_args: preset-nvidia-h264

# Oliver's 4 Zone Camera System
cameras:
  oliver_fabrication:
    ffmpeg:
      inputs:
        - path: rtsp://admin:D34D8YT3@192.168.50.51:554/live/1jfiegbscbeha_p3_OTUJPAVVDCFG
          roles:
            - detect
        - path: rtsp://admin:D34D8YT3@192.168.50.51:554/live/1jfiegbscbeha_p0_OTUJPAVVDCFG
          roles:
            - record
      input_args: preset-rtsp-restream
      output_args:
        record: -f segment -segment_time 10 -segment_format mp4 -reset_timestamps 1 -strftime 1 -c copy -an
    detect:
      width: 640
      height: 360
      fps: 5
    record:
      enabled: true
      retain:
        days: 30
        mode: motion
    objects:
      track:
        - person
        - car
        - truck
      filters:
